# Variables de entorno para ejecutar el servicio localmente (fuera de Docker).
# Copiar a .env y ajustar según la base de datos local:  cp .env.example .env
# Con docker-compose no es necesario: las variables ya están definidas en docker-compose.yaml.
DB_URL=jdbc:postgresql://localhost:5432/customers
DB_USERNAME=devsu
DB_PASSWORD=devsu
